{
  "task": "swinir_sr_classical_patch128_x2"     //  classical image sr for x2/x3/x4/x8. root/task/images-models-options
  , "model": "plain3" // "plain" | "plain2" if two inputs | "plain3" if three inputs
  , "gpu_ids": [0,1,2,3,4,5,6,7]
  , "dist": true

  , "scale": 2       // 2 | 3 | 4 | 8
  , "n_channels": 1  // broadcast to "datasets", 1 for grayscale, 3 for color

  , "path": {
    "root": "superresolution"            // "denoising" | "superresolution" | "dejpeg"
    , "pretrained_netG": null      // path of pretrained model. We fine-tune X3/X4/X8 models from X2 model, so that `G_optimizer_lr` and `G_scheduler_milestones` can be halved to save time.
    , "pretrained_netE": null      // path of pretrained model
  }

  , "datasets": {
    "train": {
      "name": "train_dataset"           // just name
      , "lr_suffix": "x2"  // 注意：小写x
      , "dataset_type": "sr"         // "dncnn" | "dnpatch" | "fdncnn" | "ffdnet" | "sr" | "srmd" | "dpsr" | "plain" | "plainpatch" | "jpeg"
      , "dataroot_H": "/STLSM-main/Code/dataset/Sigsbee/Training-set/HR"                            // path of H training dataset. DIV2K (800 training images)
      , "dataroot_illumination": "/STLSM-main/Code/dataset/Sigsbee/Training-set/Hessian"
      , "dataroot_velocity": "/STLSM-main/Code/dataset/Sigsbee/Training-set/Velocity"
      , "dataroot_L": "/STLSM-main/Code/dataset/Sigsbee/Training-set/LR"              // path of L training dataset

      , "H_size":256                  // 96/144|192/384 | 128/192/256/512. LR patch size is set to 48 or 64 when compared with RCAN or RRDB.
      ,"num_patches_per_file": 16

      , "dataloader_shuffle": true
      , "dataloader_num_workers": 2
      , "dataloader_batch_size": 1    // batch size 1 | 16 | 32 | 48 | 64 | 128. Total batch size =4x8=32 in SwinIR


    }
    , "test": {
      "name": "test_dataset"            // just name
      , "lr_suffix": "x2"  // 注意：小写x
      , "dataset_type": "sr"         // "dncnn" | "dnpatch" |  "fdncnn" | "ffdnet" | "sr" | "srmd" | "dpsr" | "plain" | "plainpatch" | "jpeg"
      , "dataroot_H": "/STLSM-main/Code/dataset/Sigsbee/Validation-set/HR"  // path of H testing dataset
      , "dataroot_illumination": "/STLSM-main/Code/dataset/Sigsbee/Validation-set/Hessian"
      , "dataroot_velocity": "/STLSM-main/Code/dataset/Sigsbee/Validation-set/Velocity"
      , "dataroot_L": "/STLSM-main/Code/dataset/Sigsbee/Validation-set/LR"              // path of L testing dataset
      ,"H_size": 256
      ,"num_patches_per_file": 16

      ,"dataloader_shuffle": false
      ,"dataloader_num_workers": 1
      ,"dataloader_batch_size": 1


    }
  }

  , "netG": {
    "net_type": "swinir" 
    , "upscale": 2                      // 2 | 3  | 4 | 8
    , "in_chans": 1
    , "img_size": 128                  // For fair comparison, LR patch size is set to 48 or 64 when compared with RCAN or RRDB.
    , "window_size": 8
    , "img_range": 1.0 
    , "depths": [6, 6, 6, 6, 6, 6] 
    , "embed_dim": 180
    , "num_heads": [6, 6, 6, 6, 6, 6]
    , "mlp_ratio": 2 
    , "upsampler": "pixelshuffle"        // "pixelshuffle" | "pixelshuffledirect" | "nearest+conv" | null
    , "resi_connection": "1conv"        // "1conv" | "3conv"

    , "init_type": "default"
  }

  , "train": {
    "G_lossfn_type": "mse_ssim"               // "l1" preferred | "l2sum" | "l2" | "ssim" | "charbonnier"| "enhanced_charbonnier"|"mse_ssim"|"l1_ssim"
    ,"G_ssim_alpha": 0.6       // 添加 alpha 参数
    ,"G_ssim_window_size": 11    // 添加窗口大小参数
    ,"G_lossfn_weight": 1.0

    ,"perceptual_scales": [1, 0.5, 0.25]       // 多尺度参数
    ,"perceptual_weights": [1.0, 0.5, 0.25]   // 多尺度权重
    ,"grad_weight": 0.5
    ,"edge_weight": 0.1
    , "use_edge_mask": false
    ,"mask_edge_weight": 2.0
    ,"mask_dilation_size": 3
    ,"G_lossfn_weight": 1.0            // default

    , "E_decay": 0.999                  // Exponential Moving Average for netG: set 0 to disable; default setting 0.999

    , "G_optimizer_type": "adam"        // fixed, adam is enough
    , "G_optimizer_lr": 1e-4            // learning rate
    , "G_optimizer_wd": 0               // weight decay, default 0
    , "G_optimizer_clipgrad": null      // unused
    , "G_optimizer_reuse": true         // 

    , "G_scheduler_type": "MultiStepLR" // "MultiStepLR" is enough
    , "G_scheduler_milestones": [ 2430000,  4860000, 100000000000]
    , "G_scheduler_gamma": 0.5

    , "G_regularizer_orthstep": null    // unused
    , "G_regularizer_clipstep": null    // unused

    , "G_param_strict": true
    , "E_param_strict": true

    , "checkpoint_test": 50     // for testing
    , "checkpoint_save": 50   // for saving model
    , "checkpoint_print": 50     // for print
  }
}
